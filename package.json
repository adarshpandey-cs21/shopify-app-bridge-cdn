{
  "name": "shopify-app-bridge-cdn",
  "version": "1.3.0",
  "description": "Typed ES module wrapper around Shopify's App Bridge CDN script",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tsc --watch",
    "generate:types": "type-crafter generate typescript-with-decoders ./types/index.yaml ./src/generated && pnpm run lint:fix:generated && pnpm run format:generated",
    "lint:fix:generated": "eslint './src/generated/**/*.{js,ts}' --fix",
    "format:generated": "prettier --write ./src/generated/",
    "check": "tsc",
    "build": "rollup --config rollup.config.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinha-sahil/shopify-app-bridge-cdn-wrapper.git"
  },
  "keywords": [
    "shopify",
    "app-bridge",
    "cdn",
    "embedded-app"
  ],
  "author": "Sahil Sinha",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sinha-sahil/shopify-app-bridge-cdn-wrapper/issues"
  },
  "homepage": "https://github.com/sinha-sahil/shopify-app-bridge-cdn-wrapper#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "type-crafter": "^0.18.0",
    "typescript-eslint": "^8.55.0"
  },
  "dependencies": {
    "type-decoder": "^2.3.1"
  }
}
